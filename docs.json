{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Woura — Guide marchand",
  "description": "Le guide complet du marchand Woura : créer votre boutique, recevoir et livrer vos commandes, encaisser, suivre vos chiffres et gérer votre abonnement.",
  "colors": {
    "primary": "#D4941C",
    "light": "#F5B731",
    "dark": "#D4941C"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://woura.africa"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://woura.africa/fr/contact"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Ouvrir Woura",
      "href": "https://woura.africa/fr/auth/login"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "fr",
        "global": {
          "anchors": [
            {
              "anchor": "woura.africa",
              "icon": "globe",
              "href": "https://woura.africa"
            },
            {
              "anchor": "Tarifs",
              "icon": "badge-percent",
              "href": "https://woura.africa/fr/pricing"
            },
            {
              "anchor": "Support",
              "icon": "life-buoy",
              "href": "https://woura.africa/fr/contact"
            }
          ]
        },
        "tabs": [
          {
            "tab": "Démarrer",
            "icon": "rocket",
            "groups": [
              {
                "group": "Démarrer",
                "pages": [
                  "index",
                  "demarrer/creer-votre-compte",
                  "demarrer/premiere-journee",
                  "demarrer/credits-et-abonnement",
                  "demarrer/glossaire"
                ]
              }
            ]
          },
          {
            "tab": "Connecter",
            "icon": "plug",
            "groups": [
              {
                "group": "Vos boutiques",
                "pages": [
                  "connecter/choisir-sa-situation",
                  "connecter/shopify",
                  "connecter/woocommerce",
                  "connecter/youcan",
                  "connecter/boutique-woura",
                  "connecter/plusieurs-boutiques",
                  "connecter/synchronisation"
                ]
              },
              {
                "group": "WhatsApp",
                "pages": [
                  "connecter/whatsapp-relier",
                  "connecter/assistant-whatsapp",
                  "connecter/catalogue-whatsapp",
                  "connecter/campagnes-whatsapp",
                  "connecter/notifications-whatsapp",
                  "connecter/fenetre-24-heures"
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}